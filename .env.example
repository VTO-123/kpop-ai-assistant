# 复制本文件为 .env.local 再填写（.env.local 已被 .gitignore 忽略，不会被提交）
# 不填 AI_API_KEY 也能跑：会自动进入 DEMO 演示模式，返回内置示例档案。

# 必填：任意 OpenAI 兼容接口的 Key
AI_API_KEY=

# 可选：接口地址（默认 DeepSeek，换 OpenAI 填 https://api.openai.com/v1）
AI_BASE_URL=https://api.deepseek.com/v1

# 可选：模型名（DeepSeek: deepseek-chat；OpenAI: gpt-4o-mini）
AI_MODEL=deepseek-chat

# 可选：服务端口与监听地址
PORT=4321
HOST=127.0.0.1

# 可选：设为 1 时强制使用离线演示数据
# DEMO_MODE=1

# 可选：上游请求超时（毫秒）
AI_TIMEOUT_MS=60000

# 可选：封面兜底（内置 data/groups.json 没配封面时，按团体名去网易云取歌手头像）
# COVER_LOOKUP=0
# COVER_API_BASE=https://music.163.com
# COVER_TIMEOUT_MS=2500
